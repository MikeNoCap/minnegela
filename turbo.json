{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_WORKER",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "API_URL",
    "WEB_URL",
    "BETTER_AUTH_SECRET",
    "ML_TEXT_EMBED_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL_ADMIN",
    "MAIL_TRANSPORT",
    "API_PORT",
    "WORKER_CACHE_DIR",
    "WORKER_CACHE_GB",
    "WORKER_CONCURRENCY",
    "ML_DEVICE",
    "ML_BATCH_SIZE",
    "GEOCODE",
    "FFMPEG_NVENC",
    "NEXT_PUBLIC_API_URL",
    "S3_JURISDICTION",
    "POSTGRES_PASSWORD"
  ]
}
