{
  "expo": {
    "name": "Minnegela",
    "slug": "minnegela",
    "version": "0.1.0",
    "scheme": "minnegela",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "no.minnegela.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Minnegela indekserer bildebiblioteket ditt slik at vennegjengen kan finne felles minner. Venner ser bare hendelser dere var på sammen; alt annet forblir privat for deg.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "nb"
      }
    },
    "android": {
      "package": "no.minnegela.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Minnegela indekserer bildebiblioteket ditt slik at vennegjengen kan finne felles minner. Venner ser bare hendelser dere var på sammen; alt annet forblir privat for deg.",
          "savePhotosPermission": "Minnegela lagrer ikke bilder i biblioteket ditt.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Minnegela indekserer bildebiblioteket ditt slik at vennegjengen kan finne felles minner. Venner ser bare hendelser dere var på sammen; alt annet forblir privat for deg.",
          "cameraPermission": "Minnegela bruker ikke kameraet."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "nb",
            "en"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e358203-0c69-47c9-99d6-f5db0641e1b3"
      }
    },
    "locales": {
      "nb": "./locales/nb.json",
      "en": "./locales/en.json"
    }
  }
}
