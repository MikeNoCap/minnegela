# ---------------------------------------------------------------------------
# Minnegela environment. Copy to .env for local development.
# ---------------------------------------------------------------------------

# Postgres. The API connects as a role subject to row-level security;
# workers connect as a role that bypasses it (see packages/db/migrations).
POSTGRES_PASSWORD=minnegela
DATABASE_URL=postgres://minnegela_api:minnegela@localhost:5432/minnegela
DATABASE_URL_WORKER=postgres://minnegela_worker:minnegela@localhost:5432/minnegela
# Used only by the migrator (needs to create extensions, roles, policies).
DATABASE_URL_ADMIN=postgres://minnegela:minnegela@localhost:5432/minnegela

# Object storage (S3 API). Two configurations, same code path.
#
# Local development / Phase 0-1: MinIO from infra/compose.dev.yml
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=minnegela-media
S3_REGION=auto
S3_ACCESS_KEY_ID=minnegela
S3_SECRET_ACCESS_KEY=minnegela-dev-secret
S3_FORCE_PATH_STYLE=true
# S3_JURISDICTION documents where the bytes live; MinIO = local box.
S3_JURISDICTION=local
#
# Production / Phase 2+: Cloudflare R2. Create the bucket with jurisdiction EU
# (cannot be changed later). Token must be scoped to this one bucket, object
# read/write only. Then:
# S3_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
# S3_BUCKET=minnegela-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<r2 token id>
# S3_SECRET_ACCESS_KEY=<r2 token secret>
# S3_FORCE_PATH_STYLE=false
# S3_JURISDICTION=eu

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
# Where magic links get printed/sent. "console" logs the link; "smtp" sends it.
MAIL_TRANSPORT=console

# Workers
WORKER_CACHE_DIR=./worker-cache
WORKER_CACHE_GB=50
WORKER_CONCURRENCY=4
ML_DEVICE=cuda            # cuda | cpu
ML_TEXT_EMBED_URL=http://localhost:4100/embed-text
ML_BATCH_SIZE=64

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
